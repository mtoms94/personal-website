  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
*/
---

<BaseLayout title="Mairead Toms">
  <article class="page-intro">
    <h1>{intro.data.title}</h1>
    <Content />
  </article>

