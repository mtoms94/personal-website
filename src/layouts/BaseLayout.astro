---
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Mairead Toms — software engineer' } = Astro.props;

const pathname = Astro.url.pathname;
const canonicalURL = new URL(pathname, Astro.site);

const isHome = pathname === '/';
const isBlog = pathname.startsWith('/blog');
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Mairead Toms" />
    <meta name="theme-color" content="#0c1822" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f7f9" media="(prefers-color-scheme: light)" />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
      })();
    </script>

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Mairead Toms" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <nav class="site-nav" aria-label="Main">
        <a class="site-name" href="/">Mairead Toms</a>
        <div class="nav-links">
          <a href="/" class:list={{ active: isHome }}>Home</a>
          {/* Blog hidden until there are posts to share
          <a href="/blog/" class:list={{ active: isBlog }}>Blog</a>
          */}
          <a href="/MaireadTomsResume.pdf">Resume</a>
          <ThemeToggle />
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <nav class="footer-links" aria-label="Social">
          <a href="https://github.com/mtoms94" rel="me noopener noreferrer" target="_blank">GitHub</a>
          <a href="https://www.linkedin.com/in/mairead-toms-a44144107/" rel="me noopener noreferrer" target="_blank">LinkedIn</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
